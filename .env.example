# Django — session/signing secret (NOT the message encryption key)
SECRET_KEY=change-me-django-secret-key-use-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Message encryption at rest — separate from SECRET_KEY
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
MESSAGE_ENCRYPTION_KEY=

# Database
POSTGRES_DB=aiomessanger
POSTGRES_USER=aiomessanger
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# CORS (comma-separated origins for the SPA)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Refresh cookie flags (set Secure=True behind HTTPS in production)
REFRESH_COOKIE_SECURE=False
REFRESH_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
